{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SPP Accountability Providers",
  "description": "Service provider metadata and quarterly reports for the ENS Service Provider Program.",
  "type": "object",
  "required": ["programs", "providers"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "programs": {
      "type": "object",
      "description": "Program definitions keyed by program ID (e.g., SPP1, SPP2).",
      "additionalProperties": {
        "$ref": "#/$defs/Program"
      }
    },
    "providers": {
      "type": "array",
      "description": "All service providers across all programs.",
      "items": {
        "$ref": "#/$defs/Provider"
      }
    }
  },
  "$defs": {
    "Quarter": {
      "type": "string",
      "pattern": "^\\d{4}/Q[1-4]$",
      "description": "Quarter in YYYY/QN format (e.g., 2025/Q3)."
    },
    "Url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "Program": {
      "type": "object",
      "required": ["year1Quarters"],
      "additionalProperties": false,
      "properties": {
        "year1Quarters": {
          "type": "array",
          "items": { "$ref": "#/$defs/Quarter" },
          "minItems": 1,
          "description": "Quarters all providers report in."
        },
        "year2Quarters": {
          "type": "array",
          "items": { "$ref": "#/$defs/Quarter" },
          "description": "Second-year quarters. Only streamDuration: 2 providers report here."
        },
        "forumUrl": {
          "$ref": "#/$defs/Url",
          "description": "Governance proposal forum post."
        },
        "voteUrl": {
          "$ref": "#/$defs/Url",
          "description": "On-chain governance vote (e.g., Tally)."
        }
      }
    },
    "ProviderProgram": {
      "type": "object",
      "required": ["budget", "streamDuration"],
      "additionalProperties": false,
      "properties": {
        "proposalUrl": {
          "$ref": "#/$defs/Url",
          "description": "Provider's application or nomination for this program."
        },
        "budget": {
          "type": "integer",
          "minimum": 0,
          "description": "Annual budget in USD."
        },
        "streamDuration": {
          "type": "integer",
          "enum": [1, 2],
          "description": "Stream duration in years."
        }
      }
    },
    "Provider": {
      "type": "object",
      "required": ["name", "slug", "programs", "reports"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name."
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "URL-safe identifier. Used for avatar files (avatars/slug.ext)."
        },
        "website": {
          "$ref": "#/$defs/Url",
          "description": "Organization website."
        },
        "programs": {
          "type": "object",
          "minProperties": 1,
          "description": "Program participation. Keys must match a top-level program key.",
          "additionalProperties": {
            "$ref": "#/$defs/ProviderProgram"
          }
        },
        "reports": {
          "type": "object",
          "description": "Quarterly report URLs keyed by quarter (YYYY/QN).",
          "propertyNames": {
            "$ref": "#/$defs/Quarter"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Url"
          }
        }
      }
    }
  }
}
